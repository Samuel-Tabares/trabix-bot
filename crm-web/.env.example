# Point at the bot's PostgreSQL. Locally use the Railway Postgres PUBLIC url
# (switchyard.proxy.rlwy.net:...); on Railway use a reference to the internal url:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Single shared password that gates the whole console (one operator).
CRM_PASSWORD=change-me
