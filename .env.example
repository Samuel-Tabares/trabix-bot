WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_id
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token
WHATSAPP_APP_SECRET=your_whatsapp_app_secret
MENU_IMAGE_MEDIA_ID=your_meta_media_id
DATABASE_URL=postgresql://user:pass@host:5432/granizado_bot
ADVISOR_PHONE=573001234567
PORT=8080
TEST_DATABASE_URL=postgresql://user:pass@host:5432/granizado_bot_test
WHATSAPP_TEST_RECIPIENT=573001234567
WABA_ID=1234567890123456
# Motor de agente de IA (src/ai/agent.rs), requerido: sin esta clave el bot no
# arranca.
ANTHROPIC_API_KEY=sk-ant-...
# AGENT_DAILY_LLM_CALL_LIMIT=120

# CTWA + Conversions API de Meta (docs/PENDIENTE_capi_meta.md). WABA_ID (arriba)
# ya es una de las tres; sin las tres, el reporte de compras a Meta es un
# no-op silencioso (no bloquea nada).
# META_CAPI_DATASET_ID=
# META_CAPI_ACCESS_TOKEN=

# Secreto compartido con crm-app para POST /internal/advisor/send
# (docs/internal_advisor_send.md). Sin esta variable el endpoint responde 503:
# queda deshabilitado, nunca abierto. Debe ser el mismo valor que
# TRABIX_BOT_INTERNAL_TOKEN en crm-app.
# INTERNAL_API_TOKEN=
